Package: IsoNetAnalyzeR
Title: Isoform-Level Protein Interaction Network Analysis
Version: 0.5.5
Authors@R: c(
    person("Dimitrios S.", "Kanakoglou",
           email = "dimkan@dtu.dk", role = c("aut", "cre")),
    person("Nikolas", "Mumm",
           email = "s242825@dtu.dk", role = "aut")
